{
  "author": "Joe Opseth",
  "license": "MIT-0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/joe-op/react-hcaptcha-test.git"
  },
  "homepage": "https://github.com/joe-op/react-hcaptcha-test#readme",
  "scripts": {
    "bundle": "bin/bundle",
    "format": "node_modules/.bin/prettier --write ./**/*.jsx",
    "format:watch": "watchexec -e js,jsx -w src npm run format",
    "serve": "mkdir -p dist && cp src/index.html dist/ && bin/bundle && bin/rundevserver",
    "serve:watch": "watchexec -e html,js,jsx -w src --restart npm run serve"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "~1.14.0",
    "react": "~18.3.1",
    "react-dom": "~18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "prettier": "~3.8.1"
  }
}
